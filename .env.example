# ── Base de données ───────────────────────────────────────────────
# URI MongoDB Atlas (whitelister l'IP EDJ Labs dans Network Access)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=skan

# ── API de notification EDJ Labs ──────────────────────────────────
EDJ_API_BASE=https://api.edj-labs.com
# Tokens (X-Api-Token) — à récupérer dans le dashboard EDJ Labs.
# NE JAMAIS committer les vraies valeurs : injecter via le stack EDJ Labs.
EDJ_SMS_TOKEN=
EDJ_WA_TOKEN=
EDJ_EMAIL_TOKEN=
# Endpoint email EDJ Labs (corps : { recipients:[...], subject, html })
EDJ_EMAIL_ENDPOINT=https://api.edj-labs.com/email/send

# ── Destinataires des alertes ─────────────────────────────────────
# Multi-utilisateur : chaque compte a SON téléphone/email (Settings → Mon compte).
# Ces deux valeurs ne servent qu'à amorcer le compte admin au premier démarrage.
NOTIFY_PHONE=+33000000000
NOTIFY_EMAIL=change-me@example.com

# ── Comportement ──────────────────────────────────────────────────
# Canaux actifs (séparés par des virgules) : sms,whatsapp,email
ENABLED_CHANNELS=sms,whatsapp,email
# Fréquence du polling en minutes
POLL_INTERVAL_MIN=5
# Secret pour protéger POST /api/cron/check
CRON_SECRET=change-me-long-random-string

# ── Auth de l'app (OBLIGATOIRE) ───────────────────────────────────
# Chaîne aléatoire longue (openssl rand -hex 32) — signe les cookies de session
AUTH_SECRET=
# Amorçage du 1er compte admin (utilisé UNE fois, si aucun compte n'existe) :
#   identifiant de connexion + hash du mot de passe (npm run hash-password -- 'mot-de-passe').
# Ensuite les mots de passe vivent en base (Settings → Mon compte, page /admin).
ADMIN_USERNAME=admin
AUTH_PASSWORD_HASH=

# ── Coffre chiffré (données candidature auto-apply) ──────────────
# Clé maître AES-256 : 64 caractères hex (openssl rand -hex 32). NE JAMAIS la perdre :
# chaque utilisateur a une clé dérivée de celle-ci. Reste sur le serveur, jamais chez l'agent.
VAULT_KEY=

# URL publique (liens GO dans les SMS). Optionnel : déduite de la requête sinon.
PUBLIC_APP_URL=https://skan.example.com

# ── Assistance IA optionnelle (proxy perso) ──────────────────────
LLM_PROXY_URL=
LLM_PROXY_KEY=

# ── Runtime ───────────────────────────────────────────────────────
PORT=3000
HOSTNAME=0.0.0.0
