# Variables de l'AGENT (à copier en .env sur TON PC — NE JAMAIS committer).
# Le plus simple : skan → Settings → « Mon agent » → Générer mon jeton,
# qui affiche les deux premières lignes prêtes à coller.
#
# L'agent n'a besoin NI de MongoDB, NI de VAULT_KEY, NI des tokens EDJ Labs :
# il passe par l'API skan avec ton jeton personnel et ne voit que TES missions.

# Adresse de skan + ton jeton personnel
SKAN_URL=https://skan.example.com
AGENT_TOKEN=

# iBail : TON email de connexion (le magic link est envoyé dessus)
IBAIL_EMAIL=

# Lecture des magic links (Gmail app password — cf. README)
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_IMAP_USER=
GMAIL_IMAP_APP_PASSWORD=
